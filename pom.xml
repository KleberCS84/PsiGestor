<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.kleber</groupId>
    <artifactId>psigestor</artifactId>
    <version>0.1.0</version>
    <name>PsiGestor - gestao de consultorio de psicologia</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.5</javafx.version>
    </properties>

    <dependencies>
        <!-- Interface grafica desktop -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- Banco de dados local (arquivo psigestor.db) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- so versao.properties e filtrado: ${...} em schema.sql/css/termos fica intacto -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>versao.properties</exclude></excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>versao.properties</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.com.kleber.psigestor.ui.PsiGestorApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Instalador Windows com Java e JavaFX embutidos: mvn -P instalador clean package
            Requer JDK 21 (jpackage) e WiX Toolset 3.x no PATH. Passo a passo em docs/BUILD.md.
        -->
        <profile>
            <id>instalador</id>
            <properties>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
                <!-- fixo para sempre: e o que faz a versao nova substituir a antiga em vez de instalar ao lado -->
                <jpackage.upgradeUuid>44c90113-5f21-4401-a9b9-6f1a03b6b93f</jpackage.upgradeUuid>
            </properties>
            <build>
                <plugins>
                    <!-- o jar do app vai para a mesma pasta das dependencias (entrada do jpackage) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.2</version>
                        <configuration>
                            <outputDirectory>${jpackage.input}</outputDirectory>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-dependencias</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>exe</argument>
                                        <argument>--name</argument><argument>PsiGestor</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>Kleber Souza</argument>
                                        <argument>--description</argument><argument>Gestao de consultorio de psicologia</argument>
                                        <argument>--copyright</argument><argument>Licenca MIT</argument>
                                        <argument>--input</argument><argument>${jpackage.input}</argument>
                                        <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument><argument>br.com.kleber.psigestor.ui.Launcher</argument>
                                        <argument>--icon</argument><argument>${project.basedir}/src/packaging/windows/psigestor.ico</argument>
                                        <argument>--license-file</argument><argument>${project.basedir}/LICENSE</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument><argument>PsiGestor</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-upgrade-uuid</argument><argument>${jpackage.upgradeUuid}</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/instalador</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
